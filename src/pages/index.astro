              <p class="version"><strong>Leistung:</strong> 1–10 kW</p>
              <a href="/produktseite/">Mehr erfahren...</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact-section">
        <div class="container contact-grid">
          <div class="contact-info">
            <h2>Noch Fragen?</h2>
            <h3>Kontaktieren Sie uns -<br />Wir antworten bei allen Gezeiten</h3>
            <p>Hinterlassen Sie Ihren Namen und Ihre Kontaktdaten – wir antworten innerhalb von 48 Stunden oder weniger.</p>
            <p>Hans Waldherr, Co-Founder</p>
            <p>Hilmar Unterrainer, Co-Founder</p>
            <p>tel <a href="tel:+4976639317996">+49 7663 9317-996</a></p>
            <p>email <a href="mailto:hi@sylents.de">hi@sylents.de</a></p>
          </div>
          <div class="contact-form">
            <!-- all-inkl Formmail; Honeypot-Feld gegen simplen Bot-Spam (muss leer bleiben) -->
            <form action="/system-cgi/formmail.pl" method="post">
              <input type="hidden" name="recipient" value="hi@sylents.de" />
              <input type="hidden" name="subject" value="Kontaktanfrage über sylents.de" />
              <input type="hidden" name="redirect" value="https://www.sylents.de/danke/" />
              <input type="text" name="name" placeholder="Name *" required />
              <input type="email" name="email" placeholder="Email *" required />
              <textarea name="message" placeholder="Message *" required></textarea>
              <input type="text" name="fax" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <label class="consent">
                <input type="checkbox" required />
                <span>Ich akzeptiere die <a href="/datenschutz/">Datenschutzbedingungen</a>*</span>
              </label>
              <button type="submit" class="btn">Senden</button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-col footer-brand">
          <img src="/sylents-2c_1.svg" alt="Sylents" class="footer-logo" />
          <p class="footer-tagline">by VERVE Water Mobility GmbH</p>
          <p class="footer-desc">powerful electric waterjets — the first jet for broad leisure use.</p>
          <div class="footer-contact">
            <a href="tel:+4976639317996">+49 7663 9317-996</a>
            <a href="mailto:hi@sylents.de">hi@sylents.de</a>
          </div>
        </div>
        <div class="footer-col">
          <h4>Standorte</h4>
          <p><strong>Firmensitz</strong><br />Carl-Benz-Str. 1<br />D-79331 Teningen</p>
        </div>
        <div class="footer-col">
          <h4>Rechtliches</h4>
          <p>Amtsgericht Freiburg<br />HRB 719693</p>
          <p><strong>UID</strong> DE323526109</p>
          <p><strong>IBAN</strong> DE66 2003 0000 0020 2271 20</p>
          <p><strong>BIC</strong> HYVEDEMM300</p>
          <nav class="footer-legal">
            <a href="/impressum/">Impressum</a>
            <a href="/datenschutz/">Datenschutz</a>
            <a href="/agb/">AGB</a>
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <span>© {new Date().getFullYear()} VERVE Water Mobility GmbH</span>
          <span>Sylents — powerful electric waterjets</span>
        </div>
      </div>
    </footer>

    <script>
      // Header: transparent at top, white on scroll (matches original WP/Elementor behavior)
      const header = document.getElementById('siteHeader');
      const onScroll = () => {
        if (window.scrollY > 40) header.classList.add('scrolled');
        else header.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Outboard slideshow: click arrows / dots to switch between renderings
      const slideshow = document.getElementById('outboardSlideshow');
      if (slideshow) {
        const slides = slideshow.querySelectorAll('.slide');
        const dotsWrap = slideshow.querySelector('.slide-dots');
        const dots = Array.from(slides).map((_, i) => {
          const d = document.createElement('button');
          d.className = 'dot';
          d.type = 'button';
          d.setAttribute('aria-label', 'Darstellung ' + (i + 1));
          d.addEventListener('click', () => show(i));
          dotsWrap.appendChild(d);
          return d;
        });
        let current = 0;
        const show = (i) => {
          current = (i + slides.length) % slides.length;
          slides.forEach((s, idx) => s.classList.toggle('is-active', idx === current));
          dots.forEach((d, idx) => d.classList.toggle('is-active', idx === current));
        };
        slideshow.querySelector('.slide-prev')?.addEventListener('click', () => show(current - 1));
        slideshow.querySelector('.slide-next')?.addEventListener('click', () => show(current + 1));
        show(0);
      }

      // Generic slideshows (e.g. product cards) driven by arrows
      document.querySelectorAll('[data-slideshow]').forEach((ss) => {
        const slides = ss.querySelectorAll('.pslide');
        let cur = 0;
        const go = (i) => {
          cur = (i + slides.length) % slides.length;
          slides.forEach((s, idx) => s.classList.toggle('is-active', idx === cur));
        };
        ss.querySelector('.pbtn-prev')?.addEventListener('click', () => go(cur - 1));
        ss.querySelector('.pbtn-next')?.addEventListener('click', () => go(cur + 1));
      });
    </script>

    <script is:inline define:vars={{ heroVideoId: 'UUnTM2u_i5o' }}>
      // Hero: static image first (fast LCP), then fade into muted looping YouTube video.
      const heroWrap = document.getElementById('heroVideoWrap');
      let heroPlayer = null;
      let videoStarted = false;

      function getCoverSize() {
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const aspect = 16 / 9;
        if (vw / vh > aspect) return { w: vw, h: vw / aspect };
        return { w: vh * aspect, h: vh };
      }

      function resizeHeroPlayer() {
        if (!heroPlayer || !heroPlayer.setSize) return;
        const { w, h } = getCoverSize();
        heroPlayer.setSize(Math.round(w), Math.round(h));
      }
      window.addEventListener('resize', resizeHeroPlayer);

      function fadeInVideo() {
        if (!heroWrap || videoStarted) return;
        videoStarted = true;
        heroWrap.classList.add('is-visible');
        heroWrap.closest('.hero-section')?.classList.add('video-active');
      }

      window.onYouTubeIframeAPIReady = function () {
        if (!heroWrap) return;
        const { w, h } = getCoverSize();
        heroPlayer = new YT.Player('heroVideo', {
          videoId: heroVideoId,
          width: Math.round(w),
          height: Math.round(h),
          playerVars: {
            autoplay: 1,
            loop: 1,
            playlist: heroVideoId,
            controls: 0,
            modestbranding: 1,
            rel: 0,
            fs: 0,
            disablekb: 1,
            playsinline: 1,
            iv_load_policy: 3,
          },
          events: {
            onReady: (e) => {
              e.target.mute();
              e.target.playVideo();
              e.target.setPlaybackQuality('hd720');
            },
            onStateChange: (e) => {
              if (e.data === YT.PlayerState.PLAYING) {
                e.target.setPlaybackQuality('hd720');
                // Fade in as soon as playback actually starts (no artificial delay).
                fadeInVideo();
              } else if (e.data === YT.PlayerState.ENDED) {
                e.target.playVideo();
              }
            },
          },
        });
      };

      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(tag);
    </script>
  </body>
</html>

<style>
/* === Header — transparent at top, white on scroll === */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 18px 0;
  background: transparent;
  transition: background 0.3s ease, box-shadow 0.3s ease, padding 0.3s ease;
}
.site-header.scrolled {
  background: #ffffff;
  box-shadow: 0 1px 12px rgba(0, 0, 0, 0.08);
}
.header-inner {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 15px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo { position: relative; display: inline-block; }
.logo img { height: 37px; }
.logo-light { display: block; }
.logo-dark { display: none; }
.site-header.scrolled .logo-light { display: none; }
.site-header.scrolled .logo-dark { display: block; }
.site-header nav { display: flex; gap: 2rem; align-items: center; }
.site-header nav a {
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 500;
  transition: color 0.3s ease;
}
.site-header nav a:hover { color: var(--color-primary); }
.lang-switch { font-weight: 700; }
/* scrolled state: dark text on white */
.site-header.scrolled nav a,
.site-header.scrolled nav a:hover { color: #333333; }
.site-header.scrolled nav a:hover { color: var(--color-primary); }

/* === Hero (image first for fast LCP, then fades into YouTube video) === */
.hero-section {
  min-height: 80vh;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  text-align: center;
  position: relative;
  background-image:
    linear-gradient(rgba(0, 90, 120, 0.3), rgba(0, 50, 70, 0.55)),
    url('/kajak.jpg');
  background-size: cover;
  background-position: center;
  padding: 130px 0 80px;
}
.hero-section::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 30%, rgba(0, 188, 212, 0.18), transparent 55%);
  pointer-events: none;
}
.hero-video-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  opacity: 0;
  transition: opacity 1.2s ease;
  pointer-events: none;
}
.hero-video-wrap.is-visible {
  opacity: 1;
}
.hero-video-media {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}
.hero-video-wrap > div {
  width: 100%;
  height: 100%;
}
.hero-video-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 40%, rgba(0,188,212,0.10), rgba(13,31,36,0.45));
  pointer-events: none;
}
.hero-section .container { position: relative; z-index: 1; transition: transform 1.2s ease; }
.hero-section.video-active .container { transform: translateY(24vh); }
@media (prefers-reduced-motion: reduce) {
  .hero-video-wrap { display: none; }
}
.hero-claim { max-width: 350px; margin: 0 auto 2rem; }
.hero-section h3 {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(1.6rem, 4vw, 2.4rem);
  font-weight: 300;
  line-height: 1.22;
  color: #ffffff;
  letter-spacing: normal;
  text-shadow: 0 2px 24px rgba(0, 30, 40, 0.5);
}

/* === Intro (two-column) === */
.intro-section {
  padding: 80px 0;
}
.intro-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 4rem;
  align-items: center;
}
.intro-text { text-align: left; }
.intro-text .eyebrow { margin-bottom: 0.75rem; }
.intro-text h2 {
  font-size: clamp(1.9rem, 4vw, 2.8rem);
  line-height: 1.1;
  margin-bottom: 1.25rem;
}
.intro-text .lead {
  font-size: 1.1rem;
  line-height: 1.7;
  color: #444444;
  max-width: 520px;
  margin-bottom: 1.75rem;
}
.intro-tags {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}
.intro-tags li {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--color-primary-dark);
  background: rgba(0, 188, 212, 0.1);
  border: 1px solid rgba(0, 188, 212, 0.25);
  padding: 0.4rem 0.85rem;
  border-radius: 999px;
}
.intro-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(160deg, #f1f7f9, #dbeaee);
  border: 1px solid rgba(0, 188, 212, 0.12);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 2.5rem;
  min-height: 380px;
}
.intro-visual {
  position: relative;
}
.slideshow {
  position: relative;
  width: 100%;
  height: 360px;
}
.slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}
.slide.is-active {
  opacity: 1;
  visibility: visible;
}
.slide img {
  max-height: 360px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 20px 40px rgba(0, 60, 80, 0.18));
