---
import '../styles/tokens.css';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).toString().replace(/\/$/, '');

const partners = [
  { src: '/partner-zentipe.svg', alt: 'Zentipe Innovation AG' },
  { src: '/partner-skale.svg', alt: 'skale.io' },
  { src: '/partner-bild2.png', alt: 'partner' },
  { src: '/partner-mpe.png', alt: 'MPE Ventures' },
  { src: '/partner-bwcon.png', alt: 'bwcon' },
  { src: '/partner-bild4.png', alt: 'partner' },
  { src: '/partner-bild5.png', alt: 'partner' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sylents – powerful electric waterjets. Der erste serienreife elektrische Jetantrieb." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Montserrat self-hosted (public/fonts) — kein Google-Fonts-CDN (DSGVO) -->
    <link rel="preload" href="/fonts/montserrat-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>Sylents – powerful electric waterjets</title>
  </head>
  <body>
    <!-- Header / Nav — transparent at top, white on scroll -->
    <header class="site-header" id="siteHeader">
      <div class="header-inner">
        <a href="/" class="logo">
          <img src="/sylents-2c_1-light.svg" alt="Sylents" class="logo-light" />
          <img src="/sylents-2c_1.svg" alt="Sylents" class="logo-dark" />
        </a>
        <nav>
          <a href="/">Home</a>
          <a href="/produktseite/">Produkte</a>
          <a href="/karriere/">Karriere</a>
          <a href="/team/">Team</a>
          <a href="https://www.sylents.de/shop/">Shop</a>
          <a href="/en/" class="lang-switch">EN</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero-section">
        <div class="hero-video-wrap" id="heroVideoWrap" aria-hidden="true">
          <div class="hero-video-media"><div id="heroVideo"></div></div>
          <div class="hero-video-overlay"></div>
        </div>
        <div class="container">
          <img src="/sylents-claim.svg" alt="sylents-claim" class="hero-claim" />
          <h3>Jet-Fahrspaß auf Seen.</h3>
        </div>
      </section>

      <!-- Partners — rotating carousel (unterstützt von) -->
      <section class="partners-section">
        <div class="container">
          <p class="partners-label">unterstützt von</p>
        </div>
        <div class="partner-logos-wrapper">
          <div class="partner-logos-track">
            {[...partners, ...partners].map((p) => (
              <div class="logo-slot">
                <img src={p.src} alt={p.alt} loading="lazy" />
              </div>
            ))}
          </div>
          <div class="fade fade-left"></div>
          <div class="fade fade-right"></div>
        </div>
      </section>

      <!-- Intro -->
      <section class="intro-section">
        <div class="container intro-grid">
          <div class="intro-text">
            <span class="eyebrow">Elektrische Jetantriebe</span>
            <h2>Leise. Kraftvoll. Emissionsfrei.</h2>
            <p class="lead">Sylents entwickelt und produziert elektrische Wasserstrahlantriebe mit innenliegendem Elektromotor – wassergekühlt, blockierungsfrei und mit geschlossenem Impeller. Für langen Fahrspaß auf Seen und Küste.</p>
            <ul class="intro-tags">
              <li>Leise</li>
              <li>Emissionsfrei</li>
              <li>Blockierungsfrei</li>
              <li>Wartungsarm</li>
              <li>Sicher für Badende</li>
            </ul>
          </div>
          <div class="intro-visual">
            <div class="slideshow" id="outboardSlideshow">
              <div class="slide is-active">
                <img src="/products/outboard/frontal.png" alt="Sylents Außenboarder SY3.1 – Frontalansicht" />
              </div>
              <div class="slide">
                <img src="/products/outboard/seitlich-re.png" alt="Sylents Außenboarder SY3.1 – seitlich rechts" />
              </div>
              <div class="slide">
                <img src="/products/outboard/eingeklappt.png" alt="Sylents Außenboarder SY3.1 – eingeklappt" />
              </div>
              <div class="slide">
                <img src="/products/outboard/display.png" alt="Sylents Außenboarder SY3.1 – Display" />
              </div>
              <div class="slide">
                <img src="/products/outboard/gondel.png" alt="Sylents Außenboarder SY3.1 – Gondel" />
              </div>
              <button class="slide-btn slide-prev" type="button" aria-label="Vorherige Darstellung">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <button class="slide-btn slide-next" type="button" aria-label="Nächste Darstellung">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
              <div class="slide-dots"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Benefits: jet experience -->
      <section class="benefits-section">
        <div class="container">
          <div class="benefits-head">
            <span class="eyebrow">Jet Experience</span>
            <h2>Was Jets auszeichnet.</h2>
            <p class="benefits-lead">Lange waren Jets eine Nischenlösung. Sylents macht sie zum Standard – für jedes Freizeitboot auf dem See.</p>
          </div>
          <div class="benefits-grid">
            <div class="benefit-card">
              <div class="benefit-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#00bcd4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v3"/><path d="M12 18v3"/><path d="M3 12h3"/><path d="M18 12h3"/><path d="m8.5 8.5 4 2.5 2.5 4-4-2.5z"/></svg>
              </div>
              <h3>Wendig & direkt</h3>
              <p>Sofortiger Schub aus dem Stand und spielerisch leichtes Manövrieren – das typische Jet-Gefühl, das kein Propeller bietet.</p>
            </div>
            <div class="benefit-card">
              <div class="benefit-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#00bcd4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18c1.5 0 1.5 1.5 3 1.5S6.5 18 8 18s1.5 1.5 3 1.5S12.5 18 14 18s1.5 1.5 3 1.5S18.5 18 20 18s1.5 1.5 3 1.5"/><circle cx="12" cy="7" r="3"/><path d="M5 21c0-3.9 3.1-7 7-7"/></svg>
              </div>
              <h3>Sicher in seichten Gewässern</h3>
              <p>Keine äußeren beweglichen Teile – sicher für Badende. Und ideal für flache Ufer, Schilfzonen und Hafenbecken, wo Propeller versagen.</p>
            </div>
            <div class="benefit-card">
              <div class="benefit-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#00bcd4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
              </div>
              <h3>Verfügbar als Außen-, Innenborder & Pod</h3>
              <p>Seit Sylents gibt es den passenden Jetantrieb für jedes Freizeitboot auf dem See.</p>
            </div>
          </div>
        </div>
      </section>
      <section class="products-section">
        <div class="container">
          <h2>Unsere Produkte und Services</h2>
          <div class="products-grid">
            <div class="product-card">
              <img src="/inboard.png" alt="Innenborder" />
              <h3>Innenborder</h3>
              <p>Integrierter Elektroantrieb für den festen Einbau – leise, wartungsarm, ideal für geschützte Gewässer.</p>
              <p class="version"><strong>Leistung:</strong> 1–10 kW</p>
              <a href="/produktseite/#inboard">Mehr erfahren...</a>
            </div>
            <div class="product-card">
              <div class="product-slideshow" data-slideshow>
                <div class="pslide is-active"><img src="/products/outboard/frontal.png" alt="Sylents Außenborder SY3.1 – Frontalansicht" /></div>
                <div class="pslide"><img src="/products/outboard/seitlich-re.png" alt="Sylents Außenborder SY3.1 – seitlich rechts" /></div>
                <div class="pslide"><img src="/products/outboard/eingeklappt.png" alt="Sylents Außenborder SY3.1 – eingeklappt" /></div>
                <button class="pbtn pbtn-prev" type="button" aria-label="Vorherige Darstellung">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button class="pbtn pbtn-next" type="button" aria-label="Nächste Darstellung">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
