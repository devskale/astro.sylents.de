---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/tokens.css';

const products = [
  {
    id: 'outboard',
    name: 'Außenborder',
    tag: 'Leicht. Mobil. In Minuten startklar.',
    power: '1,0–4,5 kW',
    img: '/outboard.png',
    gallery: [
      '/products/outboard/frontal.png',
      '/products/outboard/seitlich-re.png',
      '/products/outboard/eingeklappt.png',
      '/products/outboard/display.png',
      '/products/outboard/gondel.png',
      '/products/outboard/boc.png',
    ],
    points: [
      'Nur 14,6 kg inklusive Batterie – passt auf jedes Dach und jeden Heckspiegel',
      'Geschlossener Jetantrieb: kein Propeller, keine Verletzungsgefahr',
      'Bis zu 50 Minuten Fahrspaß unter Volllast',
      'Blockierungsfrei durch Schilf, Sand und über seichte Ufer',
    ],
  },
  {
    id: 'inboard',
    name: 'Innenborder',
    tag: 'Integriert. Wartungsarm. Für geschützte Gewässer.',
    power: '1–10 kW',
    img: '/inboard.png',
    gallery: [
      '/products/inboard-jet.jpg',
      '/products/inboard-bench.png',
    ],
    points: [
      'Integrierter, wassergekühlter Elektroantrieb bis 5.000 U/min',
      'Abgestimmtes Gesamtsystem mit durchdachtem Sicherheitskonzept',
      'Alle Komponenten koordiniert und wasserdicht',
      'Wirtschaftliche Alternative für intensive Nutzung',
    ],
  },
  {
    id: 'pod',
    name: 'Pod-Antrieb',
    tag: 'Kompakt. Platzsparend. Für flache Gewässer.',
    power: '1–10 kW',
    img: '/pod.png',
    gallery: [
      '/products/pod-studio.jpg',
      '/products/pod-render.png',
      '/products/pod-prototype.png',
    ],
    points: [
      'Leichter, raumsparender Pod-Drive für Segelboote, Hausboote und Yachten',
      'Komplettes Energiemanagement aus einer Hand',
      'Ideal für seichte Gewässer, Schilfzonen und Hafenbecken',
      'Geschlossenes, unzerstörbares Antriebssystem',
    ],
  },
];
---

<SiteLayout title="Produkte | Sylents" description="Elektrische Jetantriebe als Außen-, Innenboarder und Pod – für jedes Freizeitboot auf dem See.">
  <!-- Page hero -->
  <section class="page-hero">
    <div class="container">
      <span class="breadcrumb">Produkte</span>
      <h1>Elektrische Jetantriebe</h1>
      <p>Ein Antriebsprinzip, drei Bauformen – für jedes Freizeitboot den passenden Jet: als Außenboarder, Innenboarder oder Pod-Antrieb.</p>
    </div>
  </section>

  <!-- Warum Jetantriebe -->
  <section class="why-jet">
    <div class="container">
      <div class="why-grid">
        <div>
          <span class="eyebrow">Warum Jet?</span>
          <h2>Warum ein Jetantrieb?</h2>
          <p>Jetantriebe haben keine außen liegenden Propeller – sie sind sicher für Badende, kommen durch Schilf und seichte Ufer und fahren angenehm leise. Sylents macht diese Vorteile erstmals für das breite Freizeitboote-Segment zugänglich: einfach zu installieren, robust im Betrieb und eine echte Alternative zum Propeller.</p>
        </div>
        <ul class="why-points">
          <li><strong>Sicher</strong> – keine beweglichen Teile außen, kein Verletzungsrisiko</li>
          <li><strong>Blockierungsfrei</strong> – kommt durch Schilf, Sand und flache Ufer</li>
          <li><strong>Leise</strong> – geräuscharmer Elektroantrieb, emissionsfrei</li>
          <li><strong>Wartungsarm</strong> – kein Öl, keine Winterisierung</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Erlebe es — Wasser-Video (YouTube, kostenlos gehostet) -->
  <section class="water-video">
    <div class="water-video-media">
      <div id="heroPlayer"></div>
      <div class="water-video-overlay"></div>
    </div>
    <div class="water-video-tag">sylents Fahrspaß</div>
  </section>

  <!-- Product detail sections -->
  {products.map((p, i) => (
    <section id={p.id} class="product-detail" data-reverse={i % 2 === 1}>
      <div class="container detail-grid">
        <div class="detail-visual">
          {
            p.gallery ? (
              <div class="gallery" data-gallery>
                <div class="gallery-track">
                  <img src={p.img} alt={p.name} class="gallery-slide is-active" />
                  {p.gallery.map((g) => (
                    <img src={g} alt={p.name} class="gallery-slide" loading="lazy" />
                  ))}
                </div>
                <button class="gallery-nav gallery-prev" type="button" aria-label="Vorheriges Bild" data-prev>‹</button>
                <button class="gallery-nav gallery-next" type="button" aria-label="Nächstes Bild" data-next>›</button>
                <div class="gallery-dots"></div>
              </div>
            ) : (
              <img src={p.img} alt={p.name} />
            )
          }
        </div>
        <div class="detail-body">
          <span class="detail-tag">{p.tag}</span>
          <h2>{p.name}</h2>
          <div class="detail-power"><strong>{p.power}</strong> Leistung</div>
          <ul class="detail-points">
            {p.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
          <a href="/#contact" class="btn">Anfrage senden</a>
        </div>
      </div>
    </section>
  ))}
</SiteLayout>

<script is:inline define:vars={{ heroVideoId: 'UUnTM2u_i5o' }}>
  // Wasser-Video (YouTube IFrame API) — Autoplay muted loop
  const heroWrap = document.querySelector('.water-video-media');
  let heroPlayer = null;

  function getCoverSize() {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const aspect = 16 / 9;
    if (vw / vh > aspect) return { w: vw, h: vw / aspect };
    return { w: vh * aspect, h: vh };
  }

  function resizeHeroPlayer() {
    if (!heroPlayer || !heroPlayer.setSize) return;
    const { w, h } = getCoverSize();
    heroPlayer.setSize(Math.round(w), Math.round(h));
  }
  window.addEventListener('resize', resizeHeroPlayer);

  window.onYouTubeIframeAPIReady = function () {
    if (!heroWrap) return;
    const { w, h } = getCoverSize();
    heroPlayer = new YT.Player('heroPlayer', {
      videoId: heroVideoId,
      width: Math.round(w),
      height: Math.round(h),
      playerVars: {
        autoplay: 1,
        loop: 1,
        playlist: heroVideoId,
        controls: 0,
        modestbranding: 1,
        rel: 0,
        fs: 0,
        disablekb: 1,
        playsinline: 1,
        iv_load_policy: 3,
      },
      events: {
        onReady: (e) => {
          e.target.mute();
          e.target.playVideo();
          e.target.setPlaybackQuality('hd720');
        },
        onStateChange: (e) => {
          if (e.data === YT.PlayerState.PLAYING) {
            e.target.setPlaybackQuality('hd720');
          } else if (e.data === YT.PlayerState.ENDED) {
            e.target.playVideo();
          }
        },
      },
    });
  };

  const tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  document.head.appendChild(tag);
</script>

<script>
  // Product image slideshow
  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll('.gallery-slide'));
    const dotsWrap = gallery.querySelector('.gallery-dots');
    if (slides.length < 2) return;

    let current = 0;
    const dots = slides.map((_, i) => {
      const d = document.createElement('button');
      d.setAttribute('aria-label', 'Bild ' + (i + 1));
      d.addEventListener('click', () => show(i));
      dotsWrap.appendChild(d);
      return d;
    });

    function show(i) {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.classList.toggle('is-active', idx === current));
      dots.forEach((d, idx) => d.classList.toggle('is-active', idx === current));
    }

    gallery.querySelector('[data-prev]').addEventListener('click', () => show(current - 1));
    gallery.querySelector('[data-next]').addEventListener('click', () => show(current + 1));
    show(0);
  });
</script>

<style>
.why-jet { padding: 80px 0; background: var(--color-bg-alt); }
.why-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: center; }
.why-jet h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1rem; }
.why-jet p { color: #444; line-height: 1.8; font-size: 1.05rem; }
.why-points { list-style: none; display: flex; flex-direction: column; gap: 1rem; }
.why-points li {
  background: #fff; border: 1px solid rgba(13,31,36,0.06);
  border-radius: var(--radius-md); box-shadow: var(--shadow-sm);
  padding: 1rem 1.25rem; color: #444; font-size: 0.95rem;
}
.why-points li strong { color: var(--color-primary-dark); }

.product-detail { padding: 80px 0; }

/* === Erlebe es — Wasser-Video (YouTube) === */
.water-video {
  position: relative;
  height: 70vh;
  min-height: 420px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d1f24;
}
.water-video-media {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.water-video-media > div {
  width: 100%;
  height: 100%;
}
.water-video-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 40%, rgba(0,188,212,0.10), rgba(13,31,36,0.45));
  pointer-events: none;
}
.water-video-tag {
  position: absolute;
  bottom: 32px;
  left: 32px;
  z-index: 2;
  color: #fff;
  font-size: clamp(1rem, 2vw, 1.4rem);
  font-weight: 500;
  letter-spacing: 0.02em;
  text-shadow: 0 2px 20px rgba(0,30,40,0.6);
}
.detail-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: center; }
.product-detail[data-reverse="true"] .detail-grid { direction: rtl; }
.product-detail[data-reverse="true"] .detail-grid > * { direction: ltr; }
.detail-visual {
  background-image: linear-gradient(160deg, #f1f7f9, #dbeaee);
  border: 1px solid rgba(0,188,212,0.12);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 2.5rem; min-height: 340px;
  display: flex; align-items: center; justify-content: center;
}
.detail-visual img { max-height: 320px; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,60,80,0.18)); }

/* Slideshow gallery for products with multiple images */
.gallery {
  position: relative;
  width: 100%;
  height: 340px;
  overflow: hidden;
  border-radius: var(--radius-lg);
}
.gallery-track { position: relative; width: 100%; height: 100%; }
.gallery-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  max-height: none;
  filter: drop-shadow(0 20px 40px rgba(0,60,80,0.18));
  opacity: 0;
  transition: opacity 0.6s ease;
  pointer-events: none;
}
.gallery-slide.is-active { opacity: 1; pointer-events: auto; }
.gallery-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  color: var(--color-primary-dark);
  font-size: 1.6rem;
  line-height: 1;
  cursor: pointer;
  box-shadow: var(--shadow-md);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, color 0.2s ease;
}
.gallery-nav:hover { background: var(--color-primary); color: #fff; }
.gallery-prev { left: 12px; }
.gallery-next { right: 12px; }
.gallery-dots {
  position: absolute;
  bottom: 14px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 8px;
  z-index: 2;
}
/* Button-Styles im is:global-Block am Dateiende (Buttons entstehen per JS) */

.detail-tag { display: inline-block; color: var(--color-primary); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem; }
.detail-body h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--color-primary-dark); margin-bottom: 0.75rem; }
.detail-power {
  display: inline-flex; align-items: baseline; gap: 0.4rem;
  background: rgba(0,188,212,0.1); border: 1px solid rgba(0,188,212,0.25);
  border-radius: var(--radius-pill); padding: 0.4rem 1rem;
  font-size: 0.9rem; color: #555; margin-bottom: 1.5rem;
}
.detail-power strong { color: var(--color-primary-dark); font-size: 1.05rem; }
.detail-points { list-style: none; margin: 0 0 1.75rem; display: flex; flex-direction: column; gap: 0.6rem; }
.detail-points li {
  position: relative; padding-left: 1.6rem; color: #444; line-height: 1.6; font-size: 0.98rem;
}
.detail-points li::before {
  content: ''; position: absolute; left: 0; top: 0.55em;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--color-primary);
}
@media (max-width: 800px) {
  .why-grid { grid-template-columns: 1fr; gap: 2rem; }
  .detail-grid { grid-template-columns: 1fr; gap: 2rem; }
  .product-detail[data-reverse="true"] .detail-grid { direction: ltr; }
  .detail-visual { min-height: 260px; padding: 1.5rem; }
}
</style>

<style is:global>
/* Galerie-Dots werden erst zur Laufzeit per JS erzeugt — daher global */
.gallery-dots button {
  width: 8px; height: 8px;
  border: 1px solid rgba(0,60,80,0.2);
  border-radius: 50%;
  padding: 0;
  background: rgba(255,255,255,0.6);
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}
.gallery-dots button.is-active { background: var(--color-primary); transform: scale(1.25); }
</style>
