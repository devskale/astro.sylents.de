---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

// Rechtstext aus der Content-Collection (Body = HTML 1:1 aus der alten Page).
const entry = (await getCollection('legal')).find((e) => e.id === 'agb-de');
if (!entry) throw new Error('src/content/legal/agb-de.md fehlt');
---

<SiteLayout title={entry.data.title} description={entry.data.description}>
  <section class="page-hero">
    <div class="container">
      <span class="breadcrumb">{entry.data.breadcrumb}</span>
      <h1>{entry.data.h1}</h1>
    </div>
  </section>

  <div class="prose">
    <Fragment set:html={entry.body} />
  </div>
</SiteLayout>
