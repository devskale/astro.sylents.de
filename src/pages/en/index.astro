---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/tokens.css';

// Homepage texts from the content collection (home-en). Assets (images,
// icons), hrefs and slides stay in code — only editorial text lives in
// src/content/site/home-en.md.
const home = (await getCollection('site')).find((e) => e.id === 'home-en')?.data;
if (!home) throw new Error('src/content/site/home-en.md fehlt');

const partners = [
  { src: '/partner-zentipe.svg', alt: 'Zentipe Innovation AG' },
  { src: '/partner-skale.svg', alt: 'skale.io' },
  { src: '/partner-bild2.png', alt: 'partner' },
  { src: '/partner-mpe.png', alt: 'MPE Ventures' },
  { src: '/partner-bwcon.png', alt: 'bwcon' },
  { src: '/partner-bild4.png', alt: 'partner' },
  { src: '/partner-bild5.png', alt: 'partner' },
];

const benefitIcons = [
  '<circle cx="12" cy="12" r="9"/><path d="M8.5 8.5l4 2.5 2.5 4-4-2.5z"/>',
  '<path d="M2 18c1.5 0 1.5 1.5 3 1.5S6.5 18 8 18s1.5 1.5 3 1.5S12.5 18 14 18s1.5 1.5 3 1.5S18.5 18 20 18s1.5 1.5 3 1.5"/><circle cx="12" cy="7" r="3"/><path d="M5 21c0-3.9 3.1-7 7-7"/>',
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
];
const benefits = home.benefits.cards.map((c, i) => ({ icon: benefitIcons[i], title: c.title, body: c.text }));

const productMeta = [
  { img: '/products/inboard-jet.jpg', alt: 'Inboard', href: '/en/products/#inboard' },
  { img: '/outboard.png', alt: 'Outboard', href: '/en/products/#outboard',
    slides: [
      { src: '/products/outboard/frontal.png', alt: 'Sylents outboard SY3.1 – front view' },
      { src: '/products/outboard/seitlich-re.png', alt: 'Sylents outboard SY3.1 – right side view' },
      { src: '/products/outboard/eingeklappt.png', alt: 'Sylents outboard SY3.1 – folded' },
    ] },
  { img: '/products/pod-studio.jpg', alt: 'Pod', href: '/en/products/' },
];
const products = productMeta.map((p, i) => ({ ...p, ...home.productCards.cards[i] }));
---

<SiteLayout lang="en" title={home.title} description={home.metaDescription}>
  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-video-wrap" id="heroVideoWrap" aria-hidden="true">
      <div class="hero-video-media"><div id="heroVideo"></div></div>
      <div class="hero-video-overlay"></div>
    </div>
    <div class="container">
      <img src="/sylents-claim.svg" alt="sylents-claim" class="hero-claim" />
      <h3>{home.heroTagline}</h3>
    </div>
  </section>

  <!-- Partners -->
  <section class="partners-section">
    <div class="container"><p class="partners-label">{home.partnersLabel}</p></div>
    <div class="partner-logos-wrapper">
      <div class="partner-logos-track">
        {[...partners, ...partners].map((p) => (
          <div class="logo-slot"><img src={p.src} alt={p.alt} loading="lazy" /></div>
        ))}
      </div>
      <div class="fade fade-left"></div>
      <div class="fade fade-right"></div>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro-section">
    <div class="container intro-grid">
      <div class="intro-text">
        <span class="eyebrow">{home.intro.eyebrow}</span>
        <h2>{home.intro.title}</h2>
        <p class="lead">{home.intro.lead}</p>
        <ul class="intro-tags">
          {home.intro.tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="intro-visual">
        <div class="slideshow" id="outboardSlideshow">
          <div class="slide is-active"><img src="/products/outboard/frontal.png" alt="Sylents outboard SY3.1 – front view" /></div>
          <div class="slide"><img src="/products/outboard/seitlich-re.png" alt="Sylents outboard SY3.1 – right side view" /></div>
          <div class="slide"><img src="/products/outboard/eingeklappt.png" alt="Sylents outboard SY3.1 – folded" /></div>
          <div class="slide"><img src="/products/outboard/display.png" alt="Sylents outboard SY3.1 – display" /></div>
          <div class="slide"><img src="/products/outboard/gondel.png" alt="Sylents outboard SY3.1 – gondola" /></div>
          <button class="slide-btn slide-prev" type="button" aria-label="Previous view">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button class="slide-btn slide-next" type="button" aria-label="Next view">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <div class="slide-dots"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="benefits-section">
    <div class="container">
      <div class="benefits-head">
        <span class="eyebrow">{home.benefits.eyebrow}</span>
        <h2>{home.benefits.title}</h2>
        <p class="benefits-lead">{home.benefits.lead}</p>
      </div>
      <div class="benefits-grid">
        {benefits.map((b) => (
          <div class="benefit-card">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#00bcd4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={b.icon} />
            </div>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="products-section">
    <div class="container">
      <h2>{home.productCards.title}</h2>
      <div class="products-grid">
        {products.map((p) => (
          <div class="product-card">
            {p.slides ? (
              <div class="product-slideshow" data-slideshow>
                {p.slides.map((s, i) => (
                  <div class:list={['pslide', i === 0 && 'is-active']}><img src={s.src} alt={s.alt} /></div>
                ))}
                <button class="pbtn pbtn-prev" type="button" aria-label="Previous view">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button class="pbtn pbtn-next" type="button" aria-label="Next view">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
              </div>
            ) : (
              <img src={p.img} alt={p.alt} />
            )}
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            <p class="version"><strong>{home.productCards.labelPower}:</strong> {p.power}</p>
            <a href={p.href}>{home.productCards.moreLabel}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact-section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>{home.contact.title}</h2>
        <h3>{home.contact.subtitleLines[0]}<br />{home.contact.subtitleLines[1]}</h3>
        <p>{home.contact.text}</p>
        {home.contact.persons.map((p) => <p>{p}</p>)}
        <p>{home.contact.telLabel} <a href={`tel:${home.contact.tel.replace(/[\s-]/g, '')}`}>{home.contact.tel}</a></p>
        <p>{home.contact.emailLabel} <a href={`mailto:${home.contact.email}`}>{home.contact.email}</a></p>
      </div>
      <div class="contact-form">
        <!-- all-inkl Formmail; honeypot field against simple bot spam (must stay empty) -->
        <form action="/system-cgi/formmail.pl" method="post">
          <input type="hidden" name="recipient" value="hi@sylents.de" />
          <input type="hidden" name="subject" value="Contact request via sylents.de (EN)" />
          <input type="hidden" name="redirect" value="https://www.sylents.de/danke/" />
          <input type="text" name="name" placeholder={home.contact.form.namePlaceholder} required />
          <input type="email" name="email" placeholder={home.contact.form.emailPlaceholder} required />
          <textarea name="message" placeholder={home.contact.form.messagePlaceholder} required></textarea>
          <input type="text" name="fax" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="consent">
            <input type="checkbox" required />
            <span>{home.contact.form.consentPrefix} <a href="/en/privacy/">{home.contact.form.consentLinkText}</a>*</span>
          </label>
          <button type="submit" class="btn">{home.contact.form.submit}</button>
        </form>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Outboard slideshow: click arrows / dots to switch between renderings
  const slideshow = document.getElementById('outboardSlideshow');
  if (slideshow) {
    const slides = slideshow.querySelectorAll('.slide');
    const dotsWrap = slideshow.querySelector('.slide-dots');
    const dots = Array.from(slides).map((_, i: number) => {
      const d = document.createElement('button');
      d.className = 'dot';
      d.type = 'button';
      d.setAttribute('aria-label', 'View ' + (i + 1));
      d.addEventListener('click', () => show(i));
      dotsWrap?.appendChild(d);
      return d;
    });
    let current = 0;
    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.classList.toggle('is-active', idx === current));
      dots.forEach((d, idx) => d.classList.toggle('is-active', idx === current));
    };
    slideshow.querySelector('.slide-prev')?.addEventListener('click', () => show(current - 1));
    slideshow.querySelector('.slide-next')?.addEventListener('click', () => show(current + 1));
    show(0);
  }

  // Generic slideshows (e.g. product cards) driven by arrows
  document.querySelectorAll('[data-slideshow]').forEach((ss) => {
    const slides = ss.querySelectorAll('.pslide');
    let cur = 0;
    const go = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.classList.toggle('is-active', idx === cur));
    };
    ss.querySelector('.pbtn-prev')?.addEventListener('click', () => go(cur - 1));
    ss.querySelector('.pbtn-next')?.addEventListener('click', () => go(cur + 1));
  });
</script>

<script is:inline define:vars={{ heroVideoId: 'UUnTM2u_i5o' }}>
  // Hero: static image first (fast LCP), then fade into muted looping YouTube video.
  const heroWrap = document.getElementById('heroVideoWrap');
  let heroPlayer = null;
  let videoStarted = false;

  function getCoverSize() {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const aspect = 16 / 9;
    if (vw / vh > aspect) return { w: vw, h: vw / aspect };
    return { w: vh * aspect, h: vh };
  }

  function resizeHeroPlayer() {
    if (!heroPlayer || !heroPlayer.setSize) return;
    const { w, h } = getCoverSize();
    heroPlayer.setSize(Math.round(w), Math.round(h));
  }
  window.addEventListener('resize', resizeHeroPlayer);

  function fadeInVideo() {
    if (!heroWrap || videoStarted) return;
    videoStarted = true;
    heroWrap.classList.add('is-visible');
    heroWrap.closest('.hero-section')?.classList.add('video-active');
  }

  window.onYouTubeIframeAPIReady = function () {
    if (!heroWrap) return;
    const { w, h } = getCoverSize();
    heroPlayer = new YT.Player('heroVideo', {
      videoId: heroVideoId,
      width: Math.round(w),
      height: Math.round(h),
      playerVars: {
        autoplay: 1, loop: 1, playlist: heroVideoId, controls: 0,
        modestbranding: 1, rel: 0, fs: 0, disablekb: 1, playsinline: 1, iv_load_policy: 3,
      },
      events: {
        onReady: (e) => { e.target.mute(); e.target.playVideo(); e.target.setPlaybackQuality('hd720'); },
        onStateChange: (e) => {
          if (e.data === YT.PlayerState.PLAYING) {
            e.target.setPlaybackQuality('hd720');
            fadeInVideo();
          } else if (e.data === YT.PlayerState.ENDED) {
            e.target.playVideo();
          }
        },
      },
    });
  };

  const tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  document.head.appendChild(tag);
</script>

<style>
.hero-section { min-height: 80vh; display: flex; align-items: flex-start; justify-content: center; text-align: center; position: relative;
  background-image: linear-gradient(rgba(0,90,120,0.3), rgba(0,50,70,0.55)), url('/kajak.jpg'); background-size: cover; background-position: center; padding: 130px 0 80px; }
.hero-section::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 30%, rgba(0,188,212,0.18), transparent 55%); pointer-events: none; }
.hero-section .container { position: relative; z-index: 1; }
.hero-video-wrap { position: absolute; inset: 0; overflow: hidden; opacity: 0; transition: opacity 1.2s ease; pointer-events: none; }
.hero-video-wrap.is-visible { opacity: 1; }
.hero-video-media { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
.hero-video-wrap > div { width: 100%; height: 100%; }
.hero-video-overlay { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 40%, rgba(0,188,212,0.10), rgba(13,31,36,0.45)); pointer-events: none; }
.hero-section .container { position: relative; z-index: 1; transition: transform 1.2s ease; }
.hero-section.video-active .container { transform: translateY(24vh); }
@media (prefers-reduced-motion: reduce) { .hero-video-wrap { display: none; } }
.hero-claim { max-width: 350px; margin: 0 auto 2rem; }
.hero-section h3 { font-family: 'Montserrat', sans-serif; font-size: clamp(1.6rem,4vw,2.4rem); font-weight: 300; line-height: 1.22; color: #fff; text-shadow: 0 2px 24px rgba(0,30,40,0.5); }

.partners-section { padding: 24px 0 40px; text-align: center; background: var(--color-bg-alt); overflow: hidden; }
.partners-label { color: #666; margin-bottom: 1.5rem; font-size: 0.9rem; }
.partner-logos-wrapper { position: relative; width: 100%; overflow: hidden; }
.partner-logos-track { display: flex; gap: 1.5rem; width: max-content; animation: partner-scroll 32s linear infinite; }
@keyframes partner-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(calc(-50% - 0.75rem)); } }
.logo-slot { flex-shrink: 0; width: 120px; height: 60px; display: flex; align-items: center; justify-content: center; padding: 8px; background: #fff; border-radius: 10px; border: 1px solid #ececec; }
.logo-slot img { max-width: 100%; max-height: 100%; object-fit: contain; filter: grayscale(100%); opacity: 0.6; }
.fade { position: absolute; top: 0; bottom: 0; width: 80px; pointer-events: none; z-index: 1; }
.fade-left { left: 0; background: linear-gradient(to right, var(--color-bg-alt), transparent); }
.fade-right { right: 0; background: linear-gradient(to left, var(--color-bg-alt), transparent); }

.intro-section { padding: 80px 0; }
.intro-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 4rem; align-items: center; }
.intro-text { text-align: left; }
.intro-text h2 { font-size: clamp(1.9rem,4vw,2.8rem); line-height: 1.1; margin-bottom: 1.25rem; }
.intro-text .lead { font-size: 1.1rem; line-height: 1.7; color: #444; max-width: 520px; margin-bottom: 1.75rem; }
.intro-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem; }
.intro-tags li { font-size: 0.85rem; font-weight: 600; color: var(--color-primary-dark); background: rgba(0,188,212,0.1); border: 1px solid rgba(0,188,212,0.25); padding: 0.4rem 0.85rem; border-radius: 999px; }
.intro-visual { display: flex; align-items: center; justify-content: center; background-image: linear-gradient(160deg,#f1f7f9,#dbeaee); border: 1px solid rgba(0,188,212,0.12); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); padding: 2.5rem; min-height: 380px; position: relative; }
.intro-visual img { max-height: 360px; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,60,80,0.18)); }
.slideshow { position: relative; width: 100%; height: 360px; }
.slide { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.5s ease, visibility 0.5s ease; }
.slide.is-active { opacity: 1; visibility: visible; }
.slide img { max-height: 360px; width: auto; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,60,80,0.18)); }
.slide-btn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(0,188,212,0.35); background: rgba(255,255,255,0.85); color: var(--color-primary-dark); border-radius: 50%; cursor: pointer; box-shadow: 0 4px 14px -6px rgba(0,60,80,0.25); transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease; }
.slide-btn:hover { background: var(--color-primary); color: #ffffff; }
.slide-prev { left: -6px; }
.slide-next { right: -6px; }
.slide-dots { position: absolute; bottom: -6px; left: 0; right: 0; display: flex; justify-content: center; gap: 0.5rem; z-index: 3; }

.benefits-section { padding: 80px 0; background: #fff; }
.benefits-head { text-align: center; margin-bottom: 2.5rem; }
.benefits-head h2 { font-size: clamp(1.6rem,3vw,2.2rem); }
.benefits-lead { max-width: 620px; margin: 1rem auto 0; font-size: 1.05rem; line-height: 1.6; color: #555; }
.benefits-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.75rem; }
.benefit-card { text-align: left; padding: 2rem; background: #fff; border: 1px solid rgba(13,31,36,0.06); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s; }
.benefit-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: rgba(0,188,212,0.3); }
.benefit-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background-image: linear-gradient(135deg, rgba(0,188,212,0.14), rgba(0,188,212,0.04)); border: 1px solid rgba(0,188,212,0.18); border-radius: 16px; margin-bottom: 1.1rem; }
.benefit-card h3 { font-size: 1.1rem; color: #333; margin-bottom: 0.4rem; }
.benefit-card p { font-size: 0.92rem; color: #666; line-height: 1.55; }

.products-section { padding: 80px 0; text-align: center; background: var(--color-bg-alt); }
.products-section h2 { margin-bottom: 3rem; }
.products-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2rem; text-align: left; }
.product-card { background: #fff; border: 1px solid rgba(13,31,36,0.06); border-radius: var(--radius-lg); padding: 1.75rem; box-shadow: var(--shadow-md); transition: transform 0.25s, box-shadow 0.25s; }
.product-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-6px); }
.product-card img { width: 100%; height: 200px; object-fit: contain; border-radius: var(--radius-md); background-image: linear-gradient(160deg,#f3f8fa,#e6f0f3); margin-bottom: 1.5rem; }
.product-slideshow { position: relative; width: 100%; height: 200px; border-radius: var(--radius-md); background-image: linear-gradient(160deg,#f3f8fa,#e6f0f3); margin-bottom: 1.5rem; overflow: hidden; }
.pslide { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.5s ease, visibility 0.5s ease; }
.pslide.is-active { opacity: 1; visibility: visible; }
.pslide img { max-height: 200px; width: auto; height: auto; object-fit: contain; margin-bottom: 0; filter: drop-shadow(0 14px 26px rgba(0,60,80,0.16)); }
.pbtn { position: absolute; top: 50%; transform: translateY(-50%); z-index: 3; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(0,188,212,0.35); background: rgba(255,255,255,0.9); color: var(--color-primary-dark); border-radius: 50%; cursor: pointer; box-shadow: 0 4px 12px -6px rgba(0,60,80,0.25); transition: background 0.2s ease, color 0.2s ease; }
.pbtn:hover { background: var(--color-primary); color: #ffffff; }
.pbtn-prev { left: 10px; }
.pbtn-next { right: 10px; }
.product-card h3 { font-size: 1.3rem; color: var(--color-primary); margin-bottom: 0.75rem; }
.product-card p { margin-bottom: 0.75rem; color: #333; }
.product-card .version { font-size: 0.9rem; color: #666; }
.product-card a { color: var(--color-primary-dark); font-weight: 500; display: inline-block; margin-top: 0.5rem; }

.contact-section { padding: 80px 0; background: linear-gradient(rgba(0,90,120,0.7), rgba(0,50,70,0.8)), url('/shore.jpg') center top / cover no-repeat; }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.contact-info h2 { font-size: 2rem; color: #fff; margin-bottom: 1rem; }
.contact-info h3 { font-size: 1.2rem; color: #fff; line-height: 1.4; margin-bottom: 1.5rem; }
.contact-info p { margin-bottom: 0.5rem; color: #fff; }
.contact-info a { color: var(--color-primary); }
.contact-form form { display: flex; flex-direction: column; gap: 1rem; }
.contact-form input, .contact-form textarea { background: rgba(255,255,255,0.7); border: none; border-bottom: 1px solid #ccc; border-radius: 0; padding: 0.85rem 0.5rem; color: #6b6b6b; font-family: inherit; font-size: 1rem; }
.contact-form input:focus, .contact-form textarea:focus { outline: none; border-bottom-color: var(--color-primary); }
.contact-form textarea { min-height: 120px; resize: vertical; }
.consent { display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.85rem; color: #fff; }
.consent a { color: var(--color-primary); }
@media (max-width: 900px) { .products-grid, .benefits-grid, .contact-grid { grid-template-columns: 1fr; } .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; } .slideshow { height: 280px; } .slide img { max-height: 280px; } }
</style>

<style is:global>
/* Dots are created at runtime via JS — global, not scoped */
.slide-dots .dot { width: 9px; height: 9px; padding: 0; border: none; border-radius: 50%; background: rgba(0,188,212,0.3); cursor: pointer; transition: background 0.2s ease, transform 0.2s ease; }
.slide-dots .dot.is-active { background: var(--color-primary); transform: scale(1.25); }
</style>
