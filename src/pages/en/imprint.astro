---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

// Legal text from the content collection (body = HTML 1:1 from the old page).
const entry = (await getCollection('legal')).find((e) => e.id === 'imprint-en');
if (!entry) throw new Error('src/content/legal/imprint-en.md fehlt');
---

<SiteLayout lang="en" title={entry.data.title} description={entry.data.description}>
  <section class="page-hero">
    <div class="container">
      <span class="breadcrumb">{entry.data.breadcrumb}</span>
      <h1>{entry.data.h1}</h1>
    </div>
  </section>

  <div class="prose">
    <Fragment set:html={entry.body} />
  </div>
</SiteLayout>
