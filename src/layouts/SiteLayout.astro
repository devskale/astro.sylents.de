---
import '../styles/tokens.css';
import { getLangFromUrl, altLangPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);

// Nav-/Footer-Texte + Firmendaten aus der settings-Collection.
const settings = (await getCollection('settings')).find((e) => e.id === `settings-${lang}`)?.data;
if (!settings) throw new Error(`src/content/settings/settings-${lang}.md fehlt`);

const {
  title,
  description = lang === 'en'
    ? 'Sylents – electric jet drives for leisure boats. Silent, emission-free, blockage-free.'
    : 'Sylents – elektrische Jetantriebe für Freizeitboote. Leise, emissionsfrei, blockierungsfrei.',
} = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).toString().replace(/\/$/, '');
const nav = [
  { href: lang === 'en' ? '/en/' : '/', label: settings.nav.home },
  { href: lang === 'en' ? '/en/products/' : '/produktseite/', label: settings.nav.products },
  { href: lang === 'en' ? '/en/career/' : '/karriere/', label: settings.nav.career },
  { href: lang === 'en' ? '/en/team/' : '/team/', label: settings.nav.team },
  { href: lang === 'en' ? '/en/shop-info/' : '/shop-info/', label: settings.nav.shop },
];
const switchTo = altLangPath(Astro.url);
const switchLabel = switchTo.lang === 'en' ? 'EN' : 'DE';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Montserrat self-hosted (public/fonts) — kein Google-Fonts-CDN (DSGVO) -->
    <link rel="preload" href="/fonts/montserrat-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sylents" />
  </head>
  <body>
    <!-- Header — transparent over page-hero, white on scroll -->
    <header class="site-header" id="siteHeader">
      <div class="header-inner">
        <a href="/" class="logo">
          <img src="/sylents-2c_1-light.svg" alt="Sylents" class="logo-light" />
          <img src="/sylents-2c_1.svg" alt="Sylents" class="logo-dark" />
        </a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} class={Astro.url.pathname === item.href ? 'active' : ''}>{item.label}</a>
          ))}
          <a href={switchTo.path} class="lang-switch">{switchLabel}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <SiteFooter locale={lang} />

    <script is:inline>
      const header = document.getElementById('siteHeader');
      const onScroll = () => {
        if (window.scrollY > 40) header.classList.add('scrolled');
        else header.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>

    <style is:global>
      /* Header — transparent at top, white on scroll */
      .site-header {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 100;
        padding: 18px 0;
        background: transparent;
        transition: background 0.3s ease, box-shadow 0.3s ease;
      }
      .site-header.scrolled {
        background: #ffffff;
        box-shadow: 0 1px 12px rgba(0, 0, 0, 0.08);
      }
      .header-inner {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo { position: relative; display: inline-block; }
      .logo img { height: 37px; }
      .logo-light { display: block; }
      .logo-dark { display: none; }
      .site-header.scrolled .logo-light { display: none; }
      .site-header.scrolled .logo-dark { display: block; }
      .site-header nav { display: flex; gap: 2rem; align-items: center; }
      .site-header nav a {
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 500;
        transition: color 0.3s ease;
      }
      .site-header nav a:hover,
      .site-header nav a.active { color: var(--color-primary); }
      .lang-switch { font-weight: 700; }
      .site-header.scrolled nav a { color: #333333; }
      .site-header.scrolled nav a:hover,
      .site-header.scrolled nav a.active { color: var(--color-primary); }
      @media (max-width: 600px) {
        .site-header nav { gap: 1rem; }
        .site-header nav a { font-size: 0.85rem; }
      }

      /* Page hero band (subsites) — gives transparent header a dark backdrop */
      .page-hero {
        position: relative;
        padding: 150px 0 70px;
        text-align: center;
        background-image:
          linear-gradient(rgba(0, 90, 120, 0.55), rgba(0, 50, 70, 0.78)),
          url('/shore.jpg');
        background-size: cover;
        background-position: center;
        overflow: hidden;
      }
      .page-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 0%, rgba(0, 188, 212, 0.18), transparent 55%);
        pointer-events: none;
      }
      .page-hero .container { position: relative; z-index: 1; }
      .page-hero h1 {
        color: #ffffff;
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 0.75rem;
      }
      .page-hero p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 1.1rem;
        max-width: 640px;
        margin: 0 auto;
      }
      .breadcrumb {
        display: inline-block;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-primary);
        margin-bottom: 1rem;
      }

      /* Generic content prose for legal/text pages */
      .prose {
        max-width: 760px;
        margin: 0 auto;
        padding: 80px 15px;
      }
      .prose h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin-bottom: 1.5rem; color: var(--color-primary-dark); }
      .prose h2 { font-size: 1.4rem; margin: 2rem 0 0.75rem; color: var(--color-primary-dark); }
      .prose h3 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; color: #333; }
      .prose p { margin-bottom: 1rem; line-height: 1.8; color: #444; }
      .prose strong { color: #222; }
      .prose a { color: var(--color-primary-dark); }
    </style>
  </body>
</html>
